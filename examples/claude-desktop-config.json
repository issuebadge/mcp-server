{
  "mcpServers": {
    "issuebadge": {
      "command": "node",
      "args": ["/absolute/path/to/mcp-server/dist/index.js"],
      "env": {
        "ISSUEBADGE_BASE_URL": "https://yourdomain.com/api/v1",
        "ISSUEBADGE_API_KEY": "your_api_key_here",
        "AUTH_METHOD": "sanctum",
        "DEBUG": "false"
      }
    }
  }
}