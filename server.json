{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.issuebadge/mcp-server",
  "description": "Issue verifiable certificates and badges from IssueBadge: list badge templates, send a certificate to a recipient, and create or retarget dynamic QR codes with scan analytics.",
  "repository": {
    "url": "https://github.com/issuebadge/mcp-server",
    "source": "github"
  },
  "version": "2.2.2",
  "websiteUrl": "https://issuebadge.com",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://issuebadge-mcp.issuebadge.workers.dev/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer <IssueBadge API key> — create one at https://app.issuebadge.com/developer/index",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "issuebadge-mcp-server",
      "version": "2.2.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ISSUEBADGE_API_KEY",
          "description": "IssueBadge API key from https://app.issuebadge.com/developer/index",
          "format": "string",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
